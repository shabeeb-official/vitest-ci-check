{
    "$schema": "./layout-schema.json",
    "name": "Home Interface",
    "description": "A home interface layout with logo description and chat input section.",
    "version": "1.0.0",
    "layout": [
        {
            "name": "Home Wrapper",
            "configurable": false,
            "component": "HomeWrapper",
            "props": {
                "headerHeight": "headerHeight",
                "styles": {
                    "$ref": "#/definitions/theme/styles/home-wrapper"
                }
            },
            "children": [
                {
                    "name": "Logo Section",
                    "component": "LogoSection",
                    "props": {
                        "logoImg": "https://dev-loader-roddandgunn.bayezon.com/avatar.png",
                        "titleText": "shop with ",
                        "titleBold": "Gunner",
                        "styles": {
                            "$ref": "#/definitions/theme/styles/logo-section"
                        }
                    }
                },
                {
                    "name": "Search Section",
                    "component": "SearchSection",
                    "props": {
                        "value": "searchTerm",
                        "onSearch": "handleNavigate",
                        "onChange": "onTextChange",
                        "isMobileWidth": "isMobileWidth",
                        "placeholder": "Ask Gunner...",
                        "styles": {
                            "$ref": "#/definitions/theme/styles/search-section"
                        }
                    }
                },
                {
                    "name": "Trend Section",
                    "component": "TrendSection",
                    "props": {
                        "trends": "activeTrends"
                    }
                }
            ]
        }
    ],
    "definitions": {
        "theme": {
            "styles": {
                "home-wrapper": "w-full flex items-center justify-center flex-col",
                "logo-section": {
                    "wrapper": "flex flex-col items-center gap-2 mb-4 max-w-[80%]",
                    "image": "w-[80px] h-[80px] md:w-[150px] md:h-[150px]",
                    "title": "text-2xl md:text-5xl text-[#202020]",
                    "titleBold": "font-bold"
                },
                "search-section": {
                    "textbox": "flex items-center justify-between gap-3 px-5 py-3 bg-white border border-gray-200 rounded-full shadow-sm transition-all focus-within:shadow-md",
                    "mobileWidth": "w-[90%]",
                    "desktopWidth": "w-[45%]",
                    "placeholderStyle": "flex-1 bg-transparent outline-none resize-none text-sm placeholder-gray-400 h-[44px] pt-[10px] flex items-center",
                    "sendIcon": {
                        "width": "47",
                        "height": "47",
                        "enabledFill": "#F8E300",
                        "disabledFill": "#F8E300",
                        "arrowEnabledColor": "#0A2F87",
                        "arrowDisabledColor": "#0A2F87",
                        "cursorEnabled": "cursor-pointer",
                        "cursorDisabled": "cursor-not-allowed"
                    }
                }
            }
        },
        "components": {}
    }
}