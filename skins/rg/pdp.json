{
  "$schema": "./layout-schema.json",
  "name": "Product Detail Page",
  "description": "PDP layout with fully modularized components",
  "version": "1.0.0",
  "layout": [
    {
      "$ref": "#/definitions/components/headerBar"
    },
    {
      "$ref": "#/definitions/components/mainGrid"
    }
  ],
  "definitions": {
    "theme": {
      "pageLayout": {
        "gridCols": "grid-cols-12",
        "gap": "gap-4"
      },
      "styles": {
        "ChatToogleButton": "h-[2.6rem] w-24 cursor-pointer",
        "detailSection": "bg-white w-full p-3",
        "headerWrapper": "flex mb-2 items-center",
        "backToProductsButton": "capitalize bg-black font-white hover:bg-gray-900 rounded-none",
        "detailGrid": "grid grid-cols-12 gap-4",
        "loadingTextStyle": "text-2xl font-medium capitalize",
        "imageGridStyle": "w-full overflow-hidden relative h-full col-span-12 lg:col-span-6 xl:col-span-8 2xl:col-span-8",
        "detailColumn": "w-full col-span-12 lg:col-span-6 xl:col-span-4 2xl:col-span-4",
        "productBrand": "font-copernicus text-xl font-medium text-[#363536] mb-2",
        "productTitleWrapper": "flex justify-between w-full items-center gap-4",
        "productTitle": "font-copernicus text-[25px] text-[#363536] tracking-[0.08em] pb-2",
        "favorite": "cursor-pointer right-2 top-2 z-1 rounded-[50%] p-1",
        "favoriteIcon": "text-[#242321] font-light h-[25px] w-[25px]",
        "favoriteIconChecked": "fill-[#242321]",
        "priceWrapper": "text-[22px] font-light text-[#363536]",
        "priceSale": "sale-item-color mb-2",
        "priceStrike": "text-sm font-light text-gray-500 mb-2 line-through",
        "colorSection": "mb-6 mt-3",
        "colorLabel": "capitalize block mb-2",
        "colorLabelBold": "uppercase text-[13px] text-[#595454] font-[700] mr-1",
        "colorValue": "uppercase text-[13px]",
        "colorWrapper": "flex flex-wrap gap-2 justify-start",
        "colorPill": "flex justify-center items-center cursor-pointer rounded-full",
        "colorPillSelected": "p-[3px] border-black border-2 rounded-full",
        "colorPillImage": "h-5 w-5 rounded-full",
        "sizeSection": "mb-5",
        "sizeLabel": "uppercase text-[13px] text-[#595454] font-[700] mb-2",
        "sizeGrid": "grid grid-cols-4 gap-2 justify-start",
        "sizeItem": "col-span-1 border border-black text-black text-center py-0 px-0 cursor-pointer transition-all duration-200 hover:bg-black hover:text-white",
        "sizeItemSelected": "bg-[#363536] text-white border-black text-center",
        "quantityWrapper": "flex items-center border border-gray-400 w-fit h-[32px]",
        "quantityButton": "w-10 h-full flex items-center justify-center text-[14px] text-black border-r border-gray-400 last:border-r-0 transition-colors",
        "quantityInput": "w-10 h-full text-center text-[14px] text-black bg-white border-r border-gray-400 outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none m-0",
        "quantityLabel": "block text-sm font-medium text-gray-700 mb-1",
        "buyButtonWrapper": "mb-5",
        "buttonStyle": "uppercase px-[20px] py-[15px] font-[700] w-full hover:bg-[#7B726B] transition-colors duration-200",
        "buttonIsPendingStyle": "cursor-progress bg-gray-400 text-gray-900",
        "buttonNormalStyle": "bg-black text-white",
        "infoSection": "mt-5 text-gray-600",
        "infoText": "capitalize font-light text-[13px]",
        "recommendedProductsLabel": "font-copernicus text-2xl font-medium mb-6 text-[#363536] text-center",
        "accordionWrapper": "w-full border-b border-gray-200",
        "accordionTrigger": "grid grid-cols-12 justify-between w-full text-left p-3 !no-underline hover:!no-underline",
        "accordionTriggerContent": "p-3 font-light flex flex-col gap-3 ",
        "accordionTriggerIcon": "col-span-1",
        "pointItem": "font-light text-[16px] text-[#242321]",
        "refundImageLabel": "h-[18.5px] pl-[5px] w-auto object-contain",
        "buyNowPayLaterLabel": "capitalize font-semibold mb-2",
        "productDescriptionText": "font-copernicus text-[#585858] text-[0.875rem]",
        "moreDetails": {
          "moreDetailsAccordionWrapper": "w-full border-b border-gray-200",
          "moreDetailsText": "font-copernicus uppercase font-bold w-full text-left text-[1.4rem] leading-[1.2] py-[18px] px-0 m-0 border-t border-[#e7e7e4] text-[#2c180f] cursor-pointer flex justify-between !no-underline hover:!no-underline",
          "moreDetailsItem": "font-copernicus text-gray-800 capitalize col-span-6",
          "moreDetailsValue": "font-copernicus col-span-6 text-gray-800",
          "iconType": "plus"
        },
        "additionalDetails": {
          "accordionWrapperStyle": "w-full border-b border-gray-200",
          "accordionTriggerStyle": "font-copernicus font-bold uppercase w-full text-left text-[16px] leading-[1.2] py-[18px] px-0 m-0 border-t border-[#e7e7e4] text-[#2c180f] cursor-pointer flex justify-between items-center !no-underline hover:!no-underline",
          "accordionContentStyle": "font-copernicus pt-0 px-3 pb-3 font-light tracking-[0.04em]",
          "iconType": "plus",
          "deliveryTableStyle": "w-full max-w-4xl overflow-hidden bg-white border",
          "deliveryTableRowStyle": "w-full text-left text-gray-700 overflow-scroll",
          "deliveryTableHeadStyle": "text-xs text-gray-600 capitalize bg-gray-100",
          "deliveryTableHeaderCellStyle": "font-medium border-r p-2",
          "deliveryTableDataCellStyle": "p-2"
        },
        "productImages": {
          "mobileCarouselStyle": "",
          "mobileCarouselWrapperStyle": "flex",
          "mobileImageContainerStyle": "flex-shrink-0 flex-grow-0 basis-[80%] min-w-0 relative h-full w-full px-2",
          "mobileImageStyle": "object-contain w-full",
          "desktopGridStyle": "grid grid-cols-2 gap-2",
          "desktopImageContainerStyle": "",
          "desktopImageStyle": "object-contain"
        }
      }
