      "then": [
        {
          "element": "Box",
          "props": {
            "as": "div",
            "className": "h-full w-full bg-white p-3"
          },

          "children": [
            {
              "element": "Box",
              "props": {
                "as": "div"
              },
              "children": [
                {
                  "name": "Toggle Chat Window When Closed",
                  "element": "HideSm",
                  "children": [
                    {
                      "element": "HideWhenChatPanelOpen",
                      "children": [
                        {
                          "element": "ToggleChatWindow",
                          "children": [
                            {
                              "element": "Image",
                              "props": {
                                "src": "https://storage.googleapis.com/city-beach-dev/sunny-Ai.png",
                                "className": "h-14 w-24 cursor-pointer object-contain pl-2"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "element": "Box",
                  "props": {
                    "as": "div",
                    "className": "h-full w-full flex-1 flex justify-center text-center py-20 px-4 sm:px-6"
                  },
                  "children": [
                    {
                      "element": "Box",
                      "props": {
                        "as": "div",
                        "className": "w-full"
                      },
                      "children": [
                        {
                          "element": "Text",
                          "props": {
                            "as": "h2",
                            "className": "text-2xl sm:text-3xl font-medium text-gray-800 mb-3"
                          },
                          "children": [
                            {
                              "element": "Value",
                              "props": {
                                "value": "Let's style you"
                              }
                            }
                          ]
                        },
                        {
                          "element": "Text",
                          "props": {
                            "as": "p",
                            "className": "text-[12px] sm:text-base text-gray-500 max-w-md mx-auto"
                          },
                          "children": [
                            {
                              "element": "Value",
                              "props": {
                                "value": "Start chatting with our assistant to see personalized product recommendations."
                              }
                            }
                          ]
