            {
              "name": "Toggle Panel Button",
              "element": "ShowSm",
              "children": [
                {
                  "element": "ToggleChatWindow",
                  "children": [
                    {
                      "element": "Image",
                      "props": {
                        "src": "https://www.citybeach.com/on/demandware.static/-/Library-Sites-CityBeachSharedLibrary/default/dw20260304/Back-to-chat-button.png",
                        "className": "fixed flex justify-center text-center rounded-b-lg   top-[50%] right-[-3px]  switch-toggle  w-[30px] cursor-pointer tab-switcher z-[100000]"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Product Loading",
      "element": "If",
      "when": { "operator": "is", "lhs": "loading_status", "rhs": "loading" },
