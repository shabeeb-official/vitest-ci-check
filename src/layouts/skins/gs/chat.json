{
  "$schema": "./layout-schema.json",
  "name": "Chat Interface",
  "description": "A chat interface layout with header, message list, and input section.",
  "version": "1.0.0",
  "layout": [
    {
      "name": "Chat Wrapper",
      "configurable": false,
      "component": "ChatWrapper",
      "children": [
        {
          "$ref": "#/definitions/components/chatHeader"
        },
        {
          "$ref": "#/definitions/components/chatList"
        },
        {
          "$ref": "#/definitions/components/chatInputSection"
        }
      ]
    }
  ],
  "definitions": {
    "content": {
      "chatList": {
        "initialMessage": "Hey, I’m Dewie! You can think of me as your personal AI skin sidekick. Tell me what you’re after and let’s get these feel-good moments rolling.",
        "inititalChips": [
          "De-puff my eyes",
          "Find a gift",
          "Build a routine",
          "What's new?"
        ]
      }
    },
    "theme": {
      "styles": {
        "messageBubble": {
          "base": "font-apercu font-medium rounded-2xl px-4 py-2 shadow-sm",
          "lastMessageWidth": "w-100",
          "user": {
            "background": "bg-[#e1daed]",
            "text": "text-balck"
          },
          "bot": {
            "background": "bg-[#FCC5E1]",
            "text": "text-black"
          },
          "chips": {
            "chipsFullWrap": "flex flex-wrap gap-2 w-full min-w-0",
            "chipsSection": "inline-flex max-w-full flex-wrap mt-2 p-2 bg-white rounded-2xl border cursor-pointer",
            "chipText": "text-xs font-medium text-gray-700 break-words"
          },
          "loading": {
            "wrapper": "flex items-end",
            "textStyle": "capitalize animate-text bg-gradient-to-r from-gray-700 via-gray-500 to-gray-400 bg-clip-text text-transparent text-gray-500"
          }
        },
        "chatInput": {
          "placeholderStyle": "w-full rounded-lg p-2 pb-[0.8rem] resize-none outline-none text-[16px] placeholder:text-black/80",
          "backgroundColor": "bg-[#F3F3F3]",
          "base": "rounded-lg h-fit p-3 px-5",
          "mobile": {
            "outerWrapper": "p-3 flex gap-2 items-center w-full",
            "innerWrapper": "flex gap-2 h-fit p-3 px-5 rounded-2xl w-full bg-[#F3F3F3] [&_textarea]:bg-[#F3F3F3]"
          }
        },
        "productList": {
          "cardWidth": "w-[180px] text-center",
          "imageWrap": "relative",
          "base": "bg-white overflow-hidden transition-all duration-200 cursor-pointer hover:shadow-md flex flex-col border border-black/10",
          "content": "pt-2 pb-2 flex flex-col justify-between bg-[#ffe1ea] flex-1",
          "image": "w-full h-full transition-transform duration-300",
          "brand": "font-apercu font-bold line-clamp-1 px-4",
          "title": "font-bold line-clamp-2 min-h-[3rem] px-4 text-[16.5px] text-center pb-1",
          "priceWrapper": "mx-4 py-2 bg-white flex justify-center",
          "price": "font-bold text-nowrap cursor-text px-4 w-fit text-[14px]",
          "sale": "text-sm font-bold sale-item-color cursor-text w-fit pr-4",
          "strike": "text-sm font-medium line-through cursor-text pl-4 w-fit"
        },
        "chatHeader": {
          "wrapper": "flex justify-between items-center mb-2 ",
          "inner": "flex items-center justify-center ",
          "avatarMobile": "w-[40%]",
          "avatarDesktop": "w-[40%]",
          "innerMobile": "w-[100%]",
          "innerDesktop": "w-[80%]",
          "image": "h-[45px]",
          "imageMobile": "h-[45px] mb-2.5",
          "title": "font-bold text-lg",
          "toggle": "bg-[#e1daed] hover:bg-[#e1daed] rounded-[50%] hidden cursor-pointer sm:flex p-1 lg:mr-6 "
        },
        "sendIcon": {
          "width": "47",
          "height": "47",
          "enabledFill": "#e1daed",
          "disabledFill": "#e1daed",
          "arrowEnabledColor": "#000000",
          "arrowDisabledColor": "#000000",
          "cursorEnabled": "cursor-pointer",
          "cursorDisabled": "cursor-not-allowed"
        }
      }
    },
    "components": {
      "chatList": {
        "name": "Chat List",
        "component": "ChatList",
        "props": {
          "handleChangeView": "handleChangeView",
          "handleSendTrend": "handleSendTrend",
          "handleSend": "handleSend",
          "messages": "messages"
        },
        "nested": [
          {
            "$ref": "#/definitions/components/messageBubble"
          },
          {
            "$ref": "#/definitions/components/chipsSection"
          },
          {
            "$ref": "#/definitions/components/productList"
          }
        ]
      },
      "chatHeader": {
        "name": "Chat Header",
        "component": "ChatHeader",
        "props": {
          "label": "",
          "avatar": "https://cdn.shopify.com/s/files/1/0961/2772/files/Dewie_AI-15.png?v=1776935416",
          "styles": {
            "$ref": "#/definitions/theme/styles/chatHeader"
          }
        }
      },
      "messageBubble": {
        "name": "Message Bubble",
        "component": "Bubble",
        "props": {
          "message": "message",
          "isLast": "isLast",
          "styles": {
            "$ref": "#/definitions/theme/styles/messageBubble"
          }
        }
      },
      "chipsSection": {
        "name": "Chips Section",
        "component": "Chips",
        "props": {
          "message": "message",
          "handleSend": "handleSend",
          "styles": {
            "$ref": "#/definitions/theme/styles/messageBubble/chips"
          }
        }
      },
      "productList": {
        "name": "Product List",
        "component": "ProductList",
        "props": {
          "handleChangeView": "handleChangeView",
          "message": "message",
          "isLast": "isLast",
          "showBrand": false,
          "styles": {
            "$ref": "#/definitions/theme/styles/productList"
          }
        }
      },
      "chatInputSection": {
        "name": "Chat Input Section",
        "component": "ChatInputSection",
        "props": {
          "chatWindow": true,
          "onSearch": "handleSend"
        },
        "nested": [
          {
            "name": "Chat Input Wrapper",
            "component": "ChatInputWrapper",
            "props": {
              "chatWindow": "chatWindow",
              "styles": {
                "$ref": "#/definitions/theme/styles/chatInput"
              }
            },
            "children": [
              {
                "name": "Chat Input Text Area",
                "component": "ChatInputTextArea",
                "props": {
                  "value": "searchTerm",
                  "chatWindow": "chatWindow",
                  "onSearch": "onSearch",
                  "onChange": "onTextChange",
                  "placeholder": "Ask Dewie...",
                  "placeholderStyle": {
                    "$ref": "#/definitions/theme/styles/chatInput/placeholderStyle"
                  }
                }
              },
              {
                "name": "Chat Input Actions",
                "component": "ChatInputActions",
                "props": {
                  "searchTerm": "searchTerm",
                  "chatWindow": "chatWindow",
                  "onClick": "onClick",
                  "align": "right",
                  "styles": {
                    "$ref": "#/definitions/theme/styles/sendIcon"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  }
}
