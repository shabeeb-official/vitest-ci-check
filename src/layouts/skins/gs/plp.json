        "props": {
          "label": "Brand",
          "type": "brand",
          "styles": {
            "$ref": "#/definitions/theme/styles/topBar"
          }
        }
      },
      "filterItemColor": {
        "name": "Filter Item Color",
        "component": "FilterItem",
        "props": {
          "label": "Color",
          "type": "color",
          "styles": {
