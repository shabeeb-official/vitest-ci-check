{
  "$schema": "./layout-schema.json",
  "name": "Product Listing Page",
  "description": "PLP layout converted from TOML to JSON schema style.",
  "version": "1.0.0",
  "layout": [
    {
      "name": "Product Display",
      "component": "ProductDisplay",
      "children": [
        {
          "$ref": "#/definitions/components/topBar"
        },
        {
          "$ref": "#/definitions/components/productDisplayGrid"
        }
      ]
    }
  ],
  "definitions": {
    "content": {
      "idleSection": {
        "title": "Your glow-up starts here.",
        "description": "Let's figure it out together and get you glowing ✨",
        "tilesConfig": {
          "title": "How can Dewie Beauty Advisor help you today?",
          "subtitle": "Tap to explore",
          "tiles": [
            {
              "id": "under-eye-masks",
              "title": "Under Eye Masks",
              "subtitle": "Our #1 cult favorite - energizing under eye masks",
              "query": "Show all energizing under eye masks",
              "actionType": "query",
              "image": "https://www.graceandstella.com/cdn/shop/files/f2f4f8_1.png?v=1748719373&width=1000",
              "colSpan": 2,
              "rowSpan": 2
            },
            {
              "id": "skincare-essentials",
              "title": "Skincare Essentials",
              "subtitle": "Serums, cleansers, eye creams and more",
              "query": "Skincare Essentials",
              "actionType": "query",
              "image": "https://cdn.shopify.com/s/files/1/0961/2772/files/Screen_Shot_2023-02-16_at_10.29.57_PM_1_5c83ed53-19ed-4dc1-909b-f1ff52f5c10d.png?v=1687799055",
              "colSpan": 2,
              "rowSpan": 2
            },
            {
              "id": "self-care-spa",
              "title": "Self-Care Spa",
              "subtitle": "Bath bombs, foot peels, face masks for total relaxation",
              "query": "Show Self-Care Bath bombs, foot peels, face masks",
              "actionType": "query",
              "image": "https://cdn.shopify.com/s/files/1/0961/2772/files/Best_Friends_day_Banner_-_Mobile_1_ad106c04-b10e-4f47-aa22-c9a522407d09.png?v=1774433991",
              "colSpan": 2,
              "rowSpan": 2
            },
            {
              "id": "gift-sets",
              "title": "Gift Sets",
              "subtitle": "Curated bundles perfect for gifting",
              "query": "Show all Gift Sets",
              "actionType": "query",
              "image": "https://www.graceandstella.com/cdn/shop/files/GS_Gift_Sets_Banner-Desktop_Ver.jpg?v=1758129566",
              "colSpan": 2,
              "rowSpan": 1
            },
            {
              "id": "new-arrivals",
              "title": "New Arrivals",
              "subtitle": "The latest drops you don't want to miss",
              "query": "New Arrivals",
              "actionType": "query",
              "image": "https://cdn.shopify.com/s/files/1/0961/2772/files/DSP_REC_Creative_Pimple_Patches_1200x1200_1853d474-c504-4733-80e3-9424d4a3c328_480x480.jpg?v=1751407128",
              "colSpan": 2,
              "rowSpan": 1
            },
            {
              "id": "eye-care",
              "title": "Eye Care",
              "subtitle": "Eye sticks, rollers, balms and more",
              "query": "Show Eye sticks, rollers, balms and more",
              "actionType": "query",
              "image": "https://www.graceandstella.com/cdn/shop/files/GS_Eye_Masks_Banner-Desktop_Ver.jpg?v=1758129818",
              "colSpan": 2,
              "rowSpan": 1
            }
          ]
        }
      }
    },
    "theme": {
      "pageLayout": {
        "sideBarExpanded": true,
        "direction": "rtl",
        "leftWidth": "flex-[2.5]",
        "rightWidth": "flex-[9.5]",
        "layoutClass": "border-r pr-1 border-gray-200/70",
        "mobileChatToggleButtonStyle": "fixed flex justify-center text-center rounded-b-lg bg-[#e1daed]  top-[50%] right-[-18px] rotate-90 switch-toggle h-[24px] w-[59px] cursor-pointer tab-switcher z-[100000]",
        "idleToggleBtnUrl": "https://cdn.shopify.com/s/files/1/0961/2772/files/Dewie_AI-14.png?v=1776935416",
        "loadingTextStyle": "absolute top-[5rem] left-[50%] translate-x-[-50%] text-[3rem] font-bold text-[#c9b5eb]",
        "idleView": "message"
      },

      "styles": {
        "productCard": {
          "base": "bg-white overflow-hidden transition-all duration-200 cursor-pointer hover:shadow-md flex flex-col border border-black/10",
          "imageWrap": "relative",
          "content": "pt-2 pb-2 flex flex-col justify-between bg-[#ffe1ea] flex-1",
          "image": "w-full h-full transition-transform duration-300",
          "details": "p-4 flex flex-col flex-1 justify-between",
          "brand": "font-apercu text-balance font-bold line-clamp-1 cursor-text px-4 w-fit",
          "title": "font-bold line-clamp-2 cursor-text px-4 w-fit text-[16.5px] text-center pb-1",
          "priceWrapper": "mt-8 mx-4 py-4 bg-white flex justify-center",
          "price": "font-bold text-nowrap cursor-text  w-fit text-[14px]",
          "sale": "text-sm font-bold sale-item-color cursor-text w-fit ",
          "strike": "text-sm font-medium line-through cursor-text  w-fit",
          "favorite": "cursor-pointer right-2 top-2 z-1 rounded-[50%] p-1",
          "favoriteIcon": "text-[#242321] font-light h-[25px] w-[25px]",
          "favoriteIconChecked": "fill-[#242321]"
        },
        "topBar": {
          "base": "flex items-center justify-between p-3 bg-white",
          "label": "text-xs uppercase font-medium text-gray-600",
          "filterLabel": "uppercase text-sm font-light tracking-wide text-gray-600",
          "filterItem": "cursor-pointer flex items-center justify-between gap-3 border border-gray-300 bg-white px-4 py-2 min-w-[160px]",
          "filterPanel": "mb-8 w-full flex justify-center",
          "clearButton": "capitalize bg-[#ffe1ea] text-black font-white hover:bg-gray-200 rounded-none",
          "sortFilter": "flex items-center justify-between gap-2 w-full",
          "topbarWrapper": "fw-full mb-4",
          "colorWrapper": "flex flex-wrap gap-2 justify-start",
          "colorPill": "flex justify-center items-center cursor-pointer rounded-full",
          "colorPillSelected": "p-[3px] border-black border-2 rounded-full",
          "colorPillImage": "h-5 w-5 rounded-full",
          "sortPopup": {
            "sortLabel": "text-sm font-normal text-gray-600",
            "sortTrigger": "cursor-pointer flex items-center gap-2 border border-gray-300 px-4 py-2 bg-white text-sm font-semibold uppercase tracking-wide",
            "sortChevron": "",
            "sortPopover": "z-[9999]",
            "sortContent": "bg-white border border-gray-300 shadow-none min-w-[220px]",
            "sortList": "flex flex-col",
            "sortItem": "px-4 py-3 text-sm text-gray-900 cursor-pointer hover:bg-[#e1daed]",
            "sortItemSelected": "px-4 py-3 text-sm font-semibold text-gray-900 bg-[#ffe0ea]"
          },
          "categoryFilter": {
            "base": "grid grid-cols-7 gap-2 p-3 bg-white border border-gray-300",
            "item": "flex items-center justify-between border border-gray-300 px-2 py-1.5",
            "label": "uppercase text-[12px] text-gray-900",
            "checkbox": "w-3.5 h-3.5 border border-black accent-black"
          },
          "ChatToogleButton": "h-10 cursor-pointer object-contain",
          "TopBarRight": "md:flex flex-wrap items-center gap-4 hidden w-full justify-end py-5"
        },
        "plpTiles": {
          "wrapper": "mb-6",
          "headerWrapper": "px-2",
          "title": "text-[28px] sm:text-[34px] font-semibold text-center text-black",
          "subtitle": "text-sm sm:text-base text-gray-500 text-center mt-1",
          "grid": "grid-cols-2 sm:grid-cols-6 auto-rows-[140px] sm:auto-rows-[160px] lg:auto-rows-[180px] gap-2 sm:gap-3",
          "card": "rounded-none border border-black/5",
          "cardImage": "object-cover",
          "cardOverlay": "bg-gradient-to-t from-black/60 via-black/20 to-transparent",
          "cardTitle": "text-lg sm:text-2xl font-semibold",
          "cardSubtitle": "text-xs sm:text-base text-white/95"
        },
        "idleSection": {
          "wrapper": "h-full w-full bg-white p-3",
          "toggleButton": "h-[45px] cursor-pointer object-contain",
          "tilesContainer": "h-full w-full overflow-auto px-2 py-3 sm:px-0 sm:py-2",
          "messageContainer": "h-full w-full flex-1 flex justify-center text-center py-20 px-4 sm:px-6",
          "messageInner": "w-full max-w-2xl py-8 px-2 sm:p-16 lg:p-24",
          "title": "font-apercu font-bold text-2xl sm:text-3xl text-gray-800 mb-3",
          "description": "font-apercu font-medium text-sm sm:text-base text-gray-500 max-w-md mx-auto"
        }
      }
    },
    "components": {
      "topBar": {
        "name": "Top Bar",
        "component": "TopBar",
        "props": {
          "clearfilterLabel": "clear filter",
          "brandLabel": "brand",
          "colorLabel": "color",
          "priceLabel": "price",
          "sizeLabel": "size",
          "styles": {
            "$ref": "#/definitions/theme/styles/topBar"
          }
        },
        "children": [
          {
            "$ref": "#/definitions/components/clearFilterButton"
          },
          {
            "$ref": "#/definitions/components/sortFilter"
          },
          {
            "$ref": "#/definitions/components/categoryFilter"
          }
        ]
      },
      "sortPopup": {
        "name": "Sort Popup",
        "component": "SortPopup",
        "props": {
          "sortlabel": "sort",
          "align": "start",
          "styles": {
            "$ref": "#/definitions/theme/styles/topBar/sortPopup"
          }
        }
      },
      "clearFilterButton": {
        "name": "Clear Filter Button",
        "component": "ClearFilterButton",
        "props": {
          "label": "clearfilterLabel",
          "onClick": "clearFilter",
          "slot": "right",
          "styles": {
            "$ref": "#/definitions/theme/styles/topBar"
          }
        }
      },
      "expandSunny": {
        "name": "Expand Sunny",
        "component": "ExpandeSunny",
        "props": {
          "slot": "inner-left",
          "imageURL": "https://cdn.shopify.com/s/files/1/0961/2772/files/Dewie_AI-14.png?v=1776935416",
          "styles": {
            "$ref": "#/definitions/theme/styles/topBar/ChatToogleButton"
          }
        }
      },
      "sortFilter": {
        "name": "Sort Filter",
        "component": "SortFilter",
