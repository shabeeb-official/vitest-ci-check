{
  "$schema": "./layout-schema.json",
  "name": "Home Interface",
  "description": "A home interface layout with logo description and chat input section.",
  "version": "1.0.0",
  "layout": [
    {
      "name": "Home Wrapper",
      "configurable": false,
      "component": "HomeWrapper",
      "props": {
        "headerHeight": "headerHeight",
        "styles": {
          "$ref": "#/definitions/theme/styles/home-wrapper"
        }
      },
      "children": [
        {
          "name": "Logo Section",
          "component": "LogoSection",
          "props": {
            "logoImg": "https://cdn.shopify.com/s/files/1/0961/2772/files/Dewie_AI-15.png?v=1776935416",
            "titleText": "shop with ",
            "titleBold": "Dewie",
            "styles": {
              "$ref": "#/definitions/theme/styles/logo-section"
            }
          }
        },
        {
          "name": "Search Section",
          "component": "SearchSection",
          "props": {
            "value": "searchTerm",
            "onSearch": "handleNavigate",
            "onChange": "onTextChange",
            "isMobileWidth": "isMobileWidth",
            "placeholder": "Ask Dewie...",
            "searchButtonActionIcon": "https://cdn.shopify.com/s/files/1/0961/2772/files/Glo_AI-02.png?v=1776345420",
            "styles": {
              "$ref": "#/definitions/theme/styles/search-section"
            }
          }
        },
        {
          "name": "Trend Section",
          "component": "TrendSection",
          "props": {
            "trends": "activeTrends",
            "styles": {
              "trendHeader": "text-md mb-3",
              "trendCarausal": "overflow-hidden  flex justify-center px-5",
              "trendItem": "min-w-0 relative px-2 flex-grow-0 flex-shrink-0",
              "trendImage": "rounded-lg h-[230px] w-[190px]",
              "trendNameContainer": "absolute bottom-[10%] text-white text-xl w-full text-center",
              "trendName": "text-center"
            }
          }
        }
      ]
    }
  ],
  "definitions": {
    "theme": {
      "styles": {
        "home-wrapper": "w-full flex items-center justify-center flex-col",
        "logo-section": {
          "wrapper": "flex flex-col items-center gap-2 mb-4 max-w-[80%]",
          "image": "w-[100px] md:w-[170px] h-auto object-contain",
          "title": "text-2xl md:text-5xl text-[#202020]",
          "titleBold": "font-bold"
        },
        "search-section": {
          "textbox": "flex items-center justify-between gap-3 px-5 py-3 bg-white border border-gray-200 rounded-full shadow-sm transition-all focus-within:shadow-md",
          "mobileWidth": "w-[90%]",
          "desktopWidth": "w-[45%]",
          "placeholderStyle": "flex-1 bg-transparent outline-none resize-none text-sm placeholder-gray-400 h-[44px] pt-[10px] flex items-center",
          "sendIcon": {
            "width": "47",
            "height": "47",
            "enabledFill": "#e1daed",
            "disabledFill": "#e1daed",
            "arrowEnabledColor": "#000000",
            "arrowDisabledColor": "#000000",
            "cursorEnabled": "cursor-pointer",
            "cursorDisabled": "cursor-not-allowed"
          }
        }
      }
    },
    "components": {}
  }
}
