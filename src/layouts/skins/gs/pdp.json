  "definitions": {
    "theme": {
      "pageLayout": {
        "gridCols": "grid-cols-12",
        "gap": "gap-4",
        "layoutClass": "border-r pr-1 border-gray-200/70"
      },
      "styles": {
        "ChatToogleButton": "h-10 cursor-pointer object-contain",
        "detailSection": "bg-white w-full p-3",
        "headerWrapper": "flex mb-2 items-center",
        "backToProductsButton": "capitalize bg-[#fed83f] text-black border border-transparent hover:border-black hover:bg-[#fed83f] hover:text-black rounded-none",
        "detailGrid": "grid grid-cols-12 gap-4",
        "loadingTextStyle": "text-2xl font-medium capitalize",
        "imageGridStyle": "w-full overflow-hidden relative h-full col-span-12 lg:col-span-6 xl:col-span-7 2xl:col-span-7",
        "detailColumn": "w-full col-span-12 lg:col-span-6 xl:col-span-5 2xl:col-span-5",
        "productBrand": "text-[30px] font-medium text-[#363536] mb-2",
        "productTitleWrapper": "flex justify-between w-full items-center gap-4",
        "productTitle": "font-apercu text-[30px] pb-2",
        "favorite": "cursor-pointer right-2 top-2 z-1 rounded-[50%] p-1",
        "favoriteIcon": "text-[#242321] font-light h-[25px] w-[25px]",
        "favoriteIconChecked": "fill-[#242321]",
        "priceWrapper": "flex items-baseline gap-2 pl-2.5",
        "priceSale": "font-apercu order-2 font-semibold text-[19px] text-[#1f1f1f] pl-2",
        "priceStrike": "order-1 text-[18px] font-light text-gray-400 line-through",
        "colorSection": "mt-3 mb-[50px]",
        "colorLabel": "capitalize block mb-2",
        "colorLabelBold": "uppercase text-[13px] text-[#454141] font-normal antialiased mr-1",
        "colorValue": "capitalize text-[12px] text-gray-500 font-light antialiased border-l border-gray-300 pl-[8px]",
        "colorWrapper": "flex flex-wrap gap-[30px] justify-start ml-2",
        "colorPill": "flex justify-center items-center cursor-pointer",
        "colorPillSelected": "p-[5px] border-[#ffe1ea] border-2",
        "colorPillImage": "h-12 w-10",
        "sizeSection": "mb-5",
        "sizeLabel": "uppercase text-[13px] text-[#595454] mb-2",
        "sizeGrid": "flex flex-wrap  text-nowrap gap-3 justify-start mt-2 mb-[40px]",
        "sizeItem": "uppercase text-[13px] min-w-max col-span-1 border border-grey text-[#4d4d4d] text-center py-3 px-[13px] cursor-pointer transition-all duration-200 hover:bg-gray-100 hover:text-black",
        "sizeItemSelected": "uppercase text-[13px] min-w-max col-span-1 text-center py-3 px-[13px] cursor-pointer transition-all duration-200 bg-[#ffe1ea] text-black border-0 hover:bg-[#ffe1ea] hover:text-black focus:bg-[#ffe1ea] focus:text-black",
        "quantityWrapper": "flex items-center border border-gray-300 w-fit px-2 py-1",
        "quantityButton": "w-8 h-8 flex items-center justify-center text-[13px]",
        "quantityInput": "text-[13px] text-[#595454] w-10 h-8 text-center outline-none border-0 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none m-0",
        "quantityLabel": "block text-sm font-medium text-gray-700 mb-1",
        "buyButtonWrapper": "mb-5",
        "buttonStyle": "uppercase px-[19px] py-[10px] w-full mr-[150px] bg-[#fed83f] text-black font-bold hover:text-white transition-colors duration-200",
        "buttonIsPendingStyle": "cursor-progress bg-gray-400 text-gray-900",
        "buttonNormalStyle": "",
        "infoSection": "mt-5 text-gray-600",
        "infoText": "capitalize font-light text-[13px]",
        "recommendedProductsLabel": "text-2xl font-medium mb-6 text-[#363536] text-center",
        "accordionWrapper": "w-full border-b border-gray-200",
        "accordionTrigger": "grid grid-cols-12 justify-between w-full text-left py-3 !no-underline hover:!no-underline",
        "accordionTriggerContent": "p-3 font-light flex flex-col gap-3 ",
        "accordionTriggerIcon": "col-span-1",
        "pointItem": "font-light text-[16px] text-[#242321]",
        "refundImageLabel": "",
        "buyNowPayLaterLabel": "capitalize font-semibold mb-2",
        "productDescriptionText": "font-light antialiased text-black text-[0.875rem] pt-[15px] pb-[10px]",
